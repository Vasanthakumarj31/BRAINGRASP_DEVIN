# ==============================================================================
# BrainyGrasp AWS Production Environment Variables Template
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=production
PORT=3000

# CORS & Domain Settings
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# PostgreSQL Database Configuration (AWS RDS PostgreSQL)
# Option A: Full Connection String (Recommended for RDS / Neon / Managed DB)
DATABASE_URL=postgresql://db_user:db_password@rds-instance-endpoint.rds.amazonaws.com:5432/brainygrasp_db?sslmode=require

# Option B: Individual Connection Credentials (if DATABASE_URL is not set)
DB_HOST=rds-instance-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=brainygrasp_db
DB_USER=db_user
DB_PASSWORD=db_password
DB_SSL=true

# Redis Cache & Session Storage (AWS ElastiCache / Upstash Redis)
REDIS_URL=redis://default:redis_password@elasticache-endpoint.cache.amazonaws.com:6379
# Fallback Redis fields if REDIS_URL is not used:
REDIS_HOST=elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key

# Payment Gateway (Razorpay - Production Key ID & Secret)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Shipping Integration (Shiprocket API Credentials)
SHIPROCKET_EMAIL=shipping@your-domain.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Email Service Integration (Resend API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@your-domain.com
