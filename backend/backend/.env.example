# ============================================================
# BrainyGrasp — PRODUCTION Environment Variables Template
# Copy this file as .env and fill in your real values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ============================================================

# ── Email ────────────────────────────────────────────────────
# OPTION A (recommended for production) — Resend API:
#   Sign up at https://resend.com, verify your domain, and paste the key below.
#   When RESEND_API_KEY is set, EMAIL_USER / EMAIL_PASS are NOT required.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# EMAIL_FROM is the "From" address shown in OTP emails.
# Must be from a domain you have verified in Resend.
EMAIL_FROM=BrainyGrasp <noreply@yourdomain.com>

# OPTION B (local dev fallback) — Gmail SMTP:
#   Only used when RESEND_API_KEY is not set.
#   Use a Gmail App Password (not your account password).
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-gmail-app-password

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── PostgreSQL (choose ONE block) ────────────────────────────

# OPTION A — Cloud (Neon / Supabase / Railway):
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OPTION B — Local Docker (comment out DATABASE_URL above):
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=brainygras
# DB_PASSWORD=your_password
# DB_PORT=5432

# ── Redis (choose ONE block) ─────────────────────────────────

# OPTION A — Cloud (Upstash):
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@your-url.upstash.io:6379

# OPTION B — Local Docker (comment out REDIS_URL above):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ── Environment ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of your Vercel frontend URL(s).
# If not set, the server runs in dev mode (all origins allowed).
ALLOWED_ORIGINS=https://yourapp.vercel.app,https://www.brainygrasp.com

# ── Razorpay ─────────────────────────────────────────────────
# Use rzp_test_ keys for testing, rzp_live_ keys after approval.
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# ── Admin Panel ───────────────────────────────────────────────
# ⚠️  REQUIRED — the server will NOT start if these are missing.
# There are no fallback defaults. Use a strong, unique password.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password